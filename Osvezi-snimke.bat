@echo off
setlocal DisableDelayedExpansion
set "PH_SITE_DIR=%~dp0"
powershell.exe -NoLogo -NoProfile -NonInteractive -Command "$ErrorActionPreference='Stop'; try { $root=$env:PH_SITE_DIR; $folder=Join-Path $root 'slike\snimci'; $assets=Join-Path $root 'assets'; if (!(Test-Path -LiteralPath $assets -PathType Container)) { throw 'Nedostaje folder assets. Raspakujte paket u folder sajta.' }; [void][IO.Directory]::CreateDirectory($folder); $ids=@('automobili','portreti','zivotinje','dron','pejzazi','hrana','enterijeri'); $data=[ordered]@{}; foreach ($id in $ids) { $data[$id]=@() }; $files=@(Get-ChildItem -LiteralPath $folder -File | Sort-Object Name); $count=0; foreach ($file in $files) { if ($file.Name -match '^(automobili|portreti|zivotinje|dron|pejzazi|hrana|enterijeri)([1-9][0-9]*)?\.mp4$') { $id=$Matches[1].ToLowerInvariant(); $data[$id]+=$file.Name; $count++ } }; $json=ConvertTo-Json -InputObject $data -Depth 4; $text='// Automatski spisak. Osvezava ga Osvezi-snimke.bat.'+[Environment]::NewLine+'window.SNIMCI = '+$json+';'+[Environment]::NewLine; $target=Join-Path $assets 'snimci.js'; [IO.File]::WriteAllText($target,$text,(New-Object Text.UTF8Encoding($false))); Write-Host ('Snimci pronadjeni: '+$count); foreach ($id in $ids) { Write-Host ('  '+$id+': '+$data[$id].Count) }; exit 0 } catch { Write-Host ('GRESKA: '+$_.Exception.Message); exit 1 }"
exit /b %errorlevel%
